{
  "name": "مِداد — مكتبتك الرقمية",
  "short_name": "مِداد",
  "description": "مكتبة رقمية عربية فاخرة لقراءة الكتب وإدارتها",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0b16",
  "theme_color": "#0e0b16",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./",
  "shortcuts": [
    {
      "name": "واصل القراءة",
      "short_name": "واصل",
      "description": "افتح آخر كتاب كنت تقرؤه من حيث توقّفت",
      "url": "./?open=continue",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "استكشف كتباً",
      "short_name": "استكشف",
      "url": "./?open=discover",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "أضف كتاباً",
      "short_name": "أضف",
      "url": "./?open=add",
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "book",
          "accept": [
            "application/pdf",
            "application/epub+zip",
            "text/plain",
            "text/markdown"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?open=file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}